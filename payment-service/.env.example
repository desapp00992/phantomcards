PORT=4000
SITE_B_BASE_URL=https://payments.example.com
SITE_A_BASE_URL=https://cards.example.com
SITE_A_TO_SITE_B_SECRET=replace_with_the_same_long_secret_as_site_a
SITE_B_TO_SITE_A_SECRET=replace_with_the_same_long_secret_as_site_a
PAYSTACK_SECRET_KEY=replace_with_paystack_test_or_live_secret
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
PAYMENT_DATA_FILE=./data/payment-service.json
DATA_BUNDLE_DATA_FILE=./data/data-bundles.json
DATA_BUNDLE_PAYMENT_EMAIL=approved-paystack-receipt-email@example.com
DATA_BUNDLE_ADMIN_TOKEN=replace_with_a_long_random_token

# Supabase PostgreSQL. Use the same database URL as Site A with a separate namespace.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=4
DATABASE_NAMESPACE=site_b
DATABASE_BUNDLE_NAMESPACE=bundle
