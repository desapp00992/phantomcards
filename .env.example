### PHANTOM CARDS SITE A ###
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
PAYSTACK_CURRENCY=GHS

### SEPARATE DATA BUNDLE SITE B URL ###
SITE_B_BASE_URL=http://127.0.0.1:4000

### SHARED SITE A ↔ SITE B SECRETS ###
# These values must exactly match payment-service/.env.
SITE_A_TO_SITE_B_SECRET=replace_with_a_long_random_secret
SITE_B_TO_SITE_A_SECRET=replace_with_a_different_long_random_secret
PAYMENT_SESSION_MINUTES=15

### ADMIN ###
ADMIN_APPROVAL_TOKEN=replace_with_long_random_admin_token
ADMIN_EMAIL=admin@example.com
# Prefer ADMIN_PASSWORD_HASH for deployed environments. ADMIN_PASSWORD is a local-development fallback.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

### SITE A STORAGE ###
PHANTOM_DATA_FILE=./data/phantom-cards.json

### SUPABASE POSTGRESQL (REQUIRED FOR RENDER PERSISTENCE) ###
# Use Supabase's Transaction Pooler connection string for Render.
# Keep the password URL-encoded and never expose this value to the browser.
DATABASE_URL=postgresql://postgres.project-ref:replace-with-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=4
DATABASE_NAMESPACE=site_a
